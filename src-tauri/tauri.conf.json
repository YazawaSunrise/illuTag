{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "illuTag",
  "version": "1.0.3",
  "identifier": "com.sunriseworks.illutag",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "illuTag",
        "width": 1280,
        "height": 820,
        "decorations": false,
        "dragDropEnabled": false,
        "visible": false,
        "minWidth": 500,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
    "icons/32x32.png",
    "icons/128x128.png",
    "icons/128x128@2x.png",
    "icons/icon.ico",
    "icons/icon.icns"
  ]
  }
}
