{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "illuTag",
  "version": "0.1.0",
  "identifier": "com.sunriseworks.illutag",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "illuTag",
        "width": 1280,
        "height": 820,
        "decorations": false,
        "dragDropEnabled": false,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
